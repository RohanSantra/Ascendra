# Application
NODE_ENV=development
APP_NAME=ASCENDRA
API_VERSION=v1
PORT=5000

# Client
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=

# Authentication
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

JWT_REFRESH_COOKIE_NAME=refreshToken
JWT_REFRESH_COOKIE_MAX_AGE=604800000

BCRYPT_SALT_ROUNDS=12

# Email 
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Initial Ascendra Organization
INITIAL_ORG_NAME=Ascendra
INITIAL_ORG_SLUG=ascendra

# Initial Admin Account
INITIAL_ADMIN_FIRST_NAME=Rohan
INITIAL_ADMIN_LAST_NAME=Santra
INITIAL_ADMIN_EMAIL=your-email@example.com
INITIAL_ADMIN_PASSWORD=ReplaceWithYourStrongPassword


CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret