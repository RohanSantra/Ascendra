
{
  "name": "ascendra-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the Ascendra multi-organization training and learning management platform",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bootstrap": "node scripts/bootstrap.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "test:coverage": "node --experimental-test-coverage --test \"test/**/*.test.js\"",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "ascendra",
    "backend",
    "nodejs",
    "express",
    "express-5",
    "mongodb",
    "mongoose",
    "rest-api",
    "training-management",
    "learning-management",
    "multi-tenant"
  ],
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14"
  }
}
